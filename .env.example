# 环境变量示例: 复制为自己的 shell 环境或 systemd 配置
# LLM 接入(必填): Anthropic API 或任何兼容 /v1/messages 的代理
export ANTHROPIC_BASE_URL="https://api.anthropic.com"
export ANTHROPIC_API_KEY="sk-ant-..."

# 模型选择(可选): fast 用于批量新闻分类, smart 用于个股/大盘/持仓建议与复盘教训
export LLM_FAST_MODEL="claude-haiku-4-5-20251001"
export LLM_SMART_MODEL="claude-sonnet-4-6"

# 服务端口(可选)
export PORT=8688
